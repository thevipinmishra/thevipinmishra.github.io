---
import * as stylex from '@stylexjs/stylex';
import { getImage } from 'astro:assets';
import PortraitReveal from '../components/PortraitReveal.svelte';
import ArrowRight from 'reicon/icons/ArrowRight';
import Briefcase from 'reicon/icons/Briefcase';
import Code from 'reicon/icons/Code';
import Envelope from 'reicon/icons/Envelope';
import UserCheck from 'reicon/icons/UserCheck';
import Github from 'reicon-brands/icons/Github';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import avatar from '../images/dp.jpg';
import {
	EXPERIENCE,
	HERO,
	IDENTITY,
	PROJECTS,
	SKILL_GROUPS,
	WORK,
} from '../lib/content';
import { getProfile } from '../lib/github';
import { iconSvg } from '../lib/icons';
import { skillIconSvg } from '../lib/tech';
import {
	about,
	button,
	contact,
	hero,
	layout,
	projects,
	skills as skillsStyles,
} from '../styles/site.stylex';

const profile = await getProfile();

const sharpPortrait = await getImage({
	src: avatar,
	width: 296,
	height: 296,
	format: 'webp',
	densities: [1, 2],
});
const pixelPortrait = await getImage({
	src: avatar,
	width: 18,
	height: 18,
	format: 'webp',
});

const skillRows = SKILL_GROUPS.map((group) => ({
	label: group.label,
	items: group.items.map((name) => ({
		name,
		svg: skillIconSvg(name),
	})),
}));

const icons = {
	briefcase: iconSvg(Briefcase, { size: 28 }),
	code: iconSvg(Code, { size: 28 }),
	letter: iconSvg(Envelope, { size: 16 }),
	letterMark: iconSvg(Envelope, { size: 28 }),
	user: iconSvg(UserCheck, { size: 28 }),
	github: iconSvg(Github, { size: 16 }),
	bullet: iconSvg(ArrowRight, { size: 12 }),
};

const heroRoot = stylex.props(hero.root);
const heroInner = stylex.props(hero.inner);
const portraitWrap = stylex.props(hero.portraitWrap);
const copy = stylex.props(hero.copy);
const brand = stylex.props(hero.brand);
const headline = stylex.props(hero.headline);
const support = stylex.props(hero.support);
const ctas = stylex.props(hero.ctas);
const btnPrimary = stylex.props(button.base, button.primary);
const btnGhost = stylex.props(button.base, button.ghost);

const section = stylex.props(layout.section);
const container = stylex.props(layout.container);
const sectionHead = stylex.props(layout.sectionHead);
const sectionMark = stylex.props(layout.sectionMark);
const sectionMarkTilt = stylex.props(layout.sectionMark, layout.sectionMarkTilt);
const sectionMarkSkew = stylex.props(layout.sectionMark, layout.sectionMarkSkew);
const sectionMarkAskew = stylex.props(layout.sectionMark, layout.sectionMarkAskew);
const sectionTitle = stylex.props(layout.sectionTitle);
const titleEm = stylex.props(layout.titleEm);
const titleStop = stylex.props(layout.titleStop);

const aboutGrid = stylex.props(about.grid);
const experience = stylex.props(about.experience);
const expRole = stylex.props(about.expRole);
const expMeta = stylex.props(about.expMeta);
const expList = stylex.props(about.expList);
const expItem = stylex.props(about.expItem);

const skillGroups = stylex.props(skillsStyles.groups);
const skillGroup = stylex.props(skillsStyles.group);
const skillLabel = stylex.props(skillsStyles.label);
const skillList = stylex.props(skillsStyles.list);
const skillChip = stylex.props(skillsStyles.chip);
const skillMark = stylex.props(skillsStyles.mark);
const skillsTitle = stylex.props(layout.sectionTitle, skillsStyles.title);

const projectList = stylex.props(projects.list);
const projectItem = stylex.props(projects.item);
const projectBody = stylex.props(projects.body);
const projectHeading = stylex.props(projects.heading);
const projectName = stylex.props(projects.name);
const projectStack = stylex.props(projects.stack);
const projectBullets = stylex.props(projects.bullets);
const projectBullet = stylex.props(projects.bullet);
const projectBulletMark = stylex.props(projects.bulletMark);

const contactPanel = stylex.props(contact.panel);
const contactActions = stylex.props(contact.actions);
const contactAside = stylex.props(contact.aside);
const contactAsideLink = stylex.props(contact.asideLink);

const description = `${IDENTITY.title}. ${HERO.support}`;
const mailHref = `mailto:${IDENTITY.email}`;
const githubHref = profile.html_url || IDENTITY.github;
const linkedinHref = IDENTITY.linkedin;
---

<BaseLayout
	title={`${IDENTITY.name}, ${IDENTITY.title}`}
	description={description}
>
	<section class={heroRoot.className} style={heroRoot.style} aria-label="Introduction">
		<div class={heroInner.className} style={heroInner.style}>
			<div class={portraitWrap.className} style={portraitWrap.style}>
				<PortraitReveal
					client:load
					sharpSrc={sharpPortrait.src}
					sharpSrcSet={sharpPortrait.srcSet.attribute}
					pixelSrc={pixelPortrait.src}
					alt={`${IDENTITY.name} portrait`}
					width={296}
					height={296}
					sizes="148px"
				/>
			</div>
			<div class={copy.className} style={copy.style}>
				<h1 class={brand.className} style={brand.style}>{IDENTITY.name}</h1>
				<p class={headline.className} style={headline.style}>
					{HERO.headline}
				</p>
				<p class={support.className} style={support.style}>
					{HERO.support}
				</p>
				<div class={ctas.className} style={ctas.style}>
					<a
						href={mailHref}
						class={btnPrimary.className}
						style={btnPrimary.style}
						data-cuelume-press="pulse"
						data-cuelume-release
					>
						<Icon svg={icons.letter} />
						{IDENTITY.email}
					</a>
					<a
						href={githubHref}
						class={btnGhost.className}
						style={btnGhost.style}
						target="_blank"
						rel="noopener noreferrer"
						data-cuelume-press="scan"
						data-cuelume-release
					>
						<Icon svg={icons.github} />
						GitHub
					</a>
				</div>
			</div>
		</div>
	</section>

	<section
		id="about"
		class={section.className}
		style={section.style}
		aria-labelledby="about-title"
	>
		<div class={container.className} style={container.style}>
			<div class={aboutGrid.className} style={aboutGrid.style}>
				<div>
					<div
						class={sectionHead.className}
						style={sectionHead.style}
						data-reveal="veil"
					>
						<span
							class={sectionMark.className}
							style={sectionMark.style}
							aria-hidden="true"
						>
							<Icon svg={icons.user} />
						</span>
						<h2
							id="about-title"
							class={sectionTitle.className}
							style={sectionTitle.style}
						>
							How I{' '}
							<em class={titleEm.className} style={titleEm.style}>actually</em>
							{' '}build<span class={titleStop.className} style={titleStop.style}>.</span>
						</h2>
					</div>
				</div>
				<div data-reveal="soft">
					<div class={experience.className} style={experience.style}>
						<p class={expRole.className} style={expRole.style}>
							{EXPERIENCE.role} · {EXPERIENCE.company}
						</p>
						<p class={expMeta.className} style={expMeta.style}>
							{EXPERIENCE.dates} · {EXPERIENCE.place}
						</p>
						<ul class={expList.className} style={expList.style}>
							{
								EXPERIENCE.bullets.map((item) => (
									<li class={expItem.className} style={expItem.style}>
										{item}
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section
		id="skills"
		class={section.className}
		style={section.style}
		aria-labelledby="skills-title"
	>
		<div class={container.className} style={container.style}>
			<div
				class={sectionHead.className}
				style={sectionHead.style}
				data-reveal="veil"
			>
				<span
					class={sectionMarkTilt.className}
					style={sectionMarkTilt.style}
					aria-hidden="true"
				>
					<Icon svg={icons.code} />
				</span>
				<h2 id="skills-title" class={skillsTitle.className} style={skillsTitle.style}>
					What I{' '}
					<em class={titleEm.className} style={titleEm.style}>ship</em>
					{' '}with<span class={titleStop.className} style={titleStop.style}>.</span>
				</h2>
			</div>
			<div class={skillGroups.className} style={skillGroups.style}>
				{
					skillRows.map((group) => (
						<div
							class={skillGroup.className}
							style={skillGroup.style}
							data-reveal="soft"
						>
							<p class={skillLabel.className} style={skillLabel.style}>
								{group.label}
							</p>
							<ul
								class={skillList.className}
								style={skillList.style}
								data-reveal="chips"
							>
								{group.items.map((item) => (
									<li class={skillChip.className} style={skillChip.style}>
										{item.svg ? (
											<span class={skillMark.className} style={skillMark.style}>
												<Icon svg={item.svg} />
											</span>
										) : null}
										{item.name}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section
		id="work"
		class={section.className}
		style={section.style}
		aria-labelledby="work-title"
	>
		<div class={container.className} style={container.style}>
			<div
				class={sectionHead.className}
				style={sectionHead.style}
				data-reveal="veil"
			>
				<span
					class={sectionMarkSkew.className}
					style={sectionMarkSkew.style}
					aria-hidden="true"
				>
					<Icon svg={icons.briefcase} />
				</span>
				<h2 id="work-title" class={sectionTitle.className} style={sectionTitle.style}>
					{WORK.title}<span class={titleStop.className} style={titleStop.style}>.</span>
				</h2>
			</div>
			<ul class={projectList.className} style={projectList.style}>
				{
					PROJECTS.map((project) => (
						<li
							class={projectItem.className}
							style={projectItem.style}
							data-reveal="soft"
						>
							<article class={projectBody.className} style={projectBody.style}>
								<div class={projectHeading.className} style={projectHeading.style}>
									<h3 class={projectName.className} style={projectName.style}>
										{project.title}
									</h3>
									<p class={projectStack.className} style={projectStack.style}>
										{project.stack}
									</p>
								</div>
								<ul class={projectBullets.className} style={projectBullets.style}>
									{project.bullets.map((bullet) => (
										<li class={projectBullet.className} style={projectBullet.style}>
											<span
												class={projectBulletMark.className}
												style={projectBulletMark.style}
												aria-hidden="true"
											>
												<Icon svg={icons.bullet} />
											</span>
											<span>{bullet}</span>
										</li>
									))}
								</ul>
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section
		id="contact"
		class={section.className}
		style={section.style}
		aria-labelledby="contact-title"
	>
		<div class={container.className} style={container.style}>
			<div
				class={sectionHead.className}
				style={sectionHead.style}
				data-reveal="veil"
			>
				<span
					class={sectionMarkAskew.className}
					style={sectionMarkAskew.style}
					aria-hidden="true"
				>
					<Icon svg={icons.letterMark} />
				</span>
				<h2
					id="contact-title"
					class={sectionTitle.className}
					style={sectionTitle.style}
				>
					Say{' '}
					<em class={titleEm.className} style={titleEm.style}>hello</em>
					<span class={titleStop.className} style={titleStop.style}>.</span>
				</h2>
			</div>
			<div
				class={contactPanel.className}
				style={contactPanel.style}
				data-reveal="soft"
			>
				<div class={contactActions.className} style={contactActions.style}>
					<a
						href={mailHref}
						class={btnPrimary.className}
						style={btnPrimary.style}
						data-cuelume-press="pulse"
						data-cuelume-release
					>
						<Icon svg={icons.letter} />
						{IDENTITY.email}
					</a>
					<a
						href={githubHref}
						class={btnGhost.className}
						style={btnGhost.style}
						target="_blank"
						rel="noopener noreferrer"
						data-cuelume-press="scan"
						data-cuelume-release
					>
						<Icon svg={icons.github} />
						GitHub
					</a>
				</div>
				<p class={contactAside.className} style={contactAside.style}>
					Also on{' '}
					<a
						href={linkedinHref}
						class={contactAsideLink.className}
						style={contactAsideLink.style}
						target="_blank"
						rel="noopener noreferrer"
						data-cuelume-press="whisper"
					>
						LinkedIn
					</a>
				</p>
			</div>
		</div>
	</section>
</BaseLayout>
