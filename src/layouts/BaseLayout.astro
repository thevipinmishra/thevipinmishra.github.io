---
import * as stylex from '@stylexjs/stylex';
import { Font, getImage } from 'astro:assets';
import PageAtmosphere from '../components/PageAtmosphere.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import ThemeFloat from '../components/ThemeFloat.astro';
import portrait from '../images/dp.jpg';
import { IDENTITY } from '../lib/content';
import { layout, footer } from '../styles/site.stylex';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${IDENTITY.name}, ${IDENTITY.title}`,
	description = `${IDENTITY.title}. 5+ years shipping production web apps in TypeScript, React, Next.js, and Node.js. ${IDENTITY.email}`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? IDENTITY.site);
const siteOrigin = Astro.site?.origin ?? IDENTITY.site;
const ogImage = await getImage({
	src: portrait,
	width: 1200,
	height: 1200,
	format: 'jpg',
});
const ogImageURL = new URL(ogImage.src, siteOrigin).href;

const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: IDENTITY.name,
	jobTitle: IDENTITY.title,
	url: siteOrigin,
	email: IDENTITY.email,
	image: ogImageURL,
	sameAs: [IDENTITY.github, IDENTITY.linkedin],
};

const shell = stylex.props(layout.shell);
const main = stylex.props(layout.main);
const footerRoot = stylex.props(footer.root);
const footerInner = stylex.props(footer.inner);
const footerMark = stylex.props(footer.mark);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow" />
		<meta name="author" content={IDENTITY.name} />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={IDENTITY.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:alt" content={`${IDENTITY.name} portrait`} />
		<meta property="og:locale" content="en_US" />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={`${IDENTITY.name} portrait`} />

		<meta name="theme-color" content="#fdfcfd" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#121113" media="(prefers-color-scheme: dark)" />

		<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" preload />
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					var theme =
						stored === 'light' || stored === 'dark'
							? stored
							: prefersDark
								? 'dark'
								: 'light';
					document.documentElement.dataset.theme = theme;
					document.documentElement.classList.toggle('dark', theme === 'dark');
				} catch (_) {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>
		{
			import.meta.env.DEV && (
				<>
					<link rel="stylesheet" href="/virtual:stylex.css" />
					<script>
						import('virtual:stylex:runtime');
					</script>
				</>
			)
		}
	</head>
	<body class={shell.className} style={shell.style} id="top">
		<PageAtmosphere />
		<a class="skip-link" href="#main">Skip to content</a>
		<ThemeFloat />
		<main id="main" class={main.className} style={main.style}>
			<slot />
		</main>
		<footer class={footerRoot.className} style={footerRoot.style}>
			<div class={footerInner.className} style={footerInner.style}>
				<span class={footerMark.className} style={footerMark.style}>Vipin Mishra</span>
				<span>© {year}</span>
			</div>
		</footer>
		<ScrollReveal />
		<script>
			import { initSounds } from '../lib/sounds';
			initSounds();
		</script>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: var(--space-page);
		top: 0.75rem;
		z-index: 100;
		transform: translateY(-160%);
		padding: 0.5rem 0.75rem;
		border-radius: 8px;
		background: var(--color-primary);
		color: var(--color-primary-foreground);
		font-family: var(--font-body), ui-sans-serif, sans-serif;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
	}

	.skip-link:focus {
		transform: translateY(0);
	}
</style>
