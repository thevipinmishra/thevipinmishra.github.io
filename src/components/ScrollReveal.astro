---
/**
 * Soft scroll reveals for [data-reveal] nodes.
 * Modes: veil (title wipe), soft (block lift), chips (staggered opacity).
 * Progressive: content stays visible until JS arms `.reveal-ready`.
 */
---

<script>
	function initReveal() {
		const nodes = document.querySelectorAll('[data-reveal]');
		if (!nodes.length) return;

		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduce) {
			nodes.forEach((el) => el.classList.add('is-in'));
			document.documentElement.classList.add('reveal-ready');
			return;
		}

		document.documentElement.classList.add('reveal-ready');

		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-in');
					io.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
		);

		nodes.forEach((el) => {
			const rect = el.getBoundingClientRect();
			const vh = window.innerHeight || 0;
			if (rect.top < vh * 0.92 && rect.bottom > 0) {
				el.classList.add('is-in');
				return;
			}
			io.observe(el);
		});
	}

	initReveal();
	document.addEventListener('astro:page-load', initReveal);
</script>

<style is:global>
	html.reveal-ready [data-reveal]:not(.is-in) {
		opacity: 0;
		transform: translate3d(0, 8px, 0);
		filter: blur(0);
		clip-path: inset(0 0 0 0);
		transition:
			opacity 420ms cubic-bezier(0.2, 0, 0, 1),
			transform 420ms cubic-bezier(0.2, 0, 0, 1),
			clip-path 420ms cubic-bezier(0.2, 0, 0, 1),
			filter 380ms cubic-bezier(0.2, 0, 0, 1);
	}

	html.reveal-ready [data-reveal='veil']:not(.is-in) {
		clip-path: inset(14% 0 -4% 0);
		filter: blur(4px);
	}

	html.reveal-ready [data-reveal='soft']:not(.is-in) {
		transform: translate3d(0, 10px, 0);
	}

	html.reveal-ready [data-reveal='chips']:not(.is-in) {
		opacity: 1;
		transform: none;
		filter: none;
		clip-path: none;
		transition: none;
	}

	html.reveal-ready [data-reveal='chips']:not(.is-in) > li {
		opacity: 0;
		transform: translate3d(0, 4px, 0);
	}

	html.reveal-ready [data-reveal='chips'] > li {
		transition:
			opacity 300ms cubic-bezier(0.2, 0, 0, 1),
			transform 300ms cubic-bezier(0.2, 0, 0, 1);
	}

	html.reveal-ready [data-reveal].is-in {
		opacity: 1;
		transform: none;
		clip-path: inset(0 0 0 0);
		filter: none;
	}

	html.reveal-ready [data-reveal='chips'].is-in > li {
		opacity: 1;
		transform: none;
	}

	html.reveal-ready [data-reveal='chips'].is-in > li:nth-child(1) {
		transition-delay: 40ms;
	}
	html.reveal-ready [data-reveal='chips'].is-in > li:nth-child(2) {
		transition-delay: 70ms;
	}
	html.reveal-ready [data-reveal='chips'].is-in > li:nth-child(3) {
		transition-delay: 100ms;
	}
	html.reveal-ready [data-reveal='chips'].is-in > li:nth-child(4) {
		transition-delay: 130ms;
	}
	html.reveal-ready [data-reveal='chips'].is-in > li:nth-child(5) {
		transition-delay: 160ms;
	}
	html.reveal-ready [data-reveal='chips'].is-in > li:nth-child(6) {
		transition-delay: 190ms;
	}
	html.reveal-ready [data-reveal='chips'].is-in > li:nth-child(7) {
		transition-delay: 220ms;
	}
	html.reveal-ready [data-reveal='chips'].is-in > li:nth-child(8) {
		transition-delay: 250ms;
	}
	html.reveal-ready [data-reveal='chips'].is-in > li:nth-child(n + 9) {
		transition-delay: 280ms;
	}

	@media (prefers-reduced-motion: reduce) {
		html.reveal-ready [data-reveal],
		html.reveal-ready [data-reveal='chips'] > li {
			opacity: 1 !important;
			transform: none !important;
			clip-path: none !important;
			filter: none !important;
			transition: none !important;
		}
	}
</style>
