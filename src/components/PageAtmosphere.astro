---
/**
 * Fixed decorative backdrop: canvas film grain only.
 * Canvas tiles a 128px noise texture (~12fps refresh); no CSS grain animation.
 */
---

<div class="page-atmosphere" aria-hidden="true">
	<canvas class="page-atmosphere__grain" data-page-grain></canvas>
</div>

<script>
	import { initPageGrain } from '../lib/grain';
	initPageGrain();
</script>

<style>
	.page-atmosphere {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		isolation: isolate;
		contain: strict;
	}

	.page-atmosphere__grain {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		opacity: var(--page-grain-opacity);
		mix-blend-mode: var(--page-grain-blend);
	}

	@media (max-width: 767px) {
		.page-atmosphere__grain {
			opacity: calc(var(--page-grain-opacity) * 0.75);
		}
	}
</style>
